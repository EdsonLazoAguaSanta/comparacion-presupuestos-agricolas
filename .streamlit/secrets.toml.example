# Copia este archivo como .streamlit/secrets.toml (local) y complétalo con
# valores reales. En Streamlit Cloud, estos mismos valores van pegados en
# Settings → Secrets de la app (NO se sube este archivo, solo sirve de guía).
#
# app.py acepta dos esquemas de nombres (para poder reusar tal cual el
# secrets.toml del Informe de Cierre si ya lo tienes):
#   - Nuevo:  [azure] tenant_id / client_id / client_secret
#   - Legacy: GRAPH_TENANT_ID / GRAPH_CLIENT_ID / GRAPH_CLIENT_SECRET (plano)
# Usa cualquiera de los dos, no hace falta poner ambos.

# ── Clave para firmar el token de sesión de ESTA app (genera una propia,
#    no la reutilices de otro proyecto) ──────────────────────────────────
app_secret_key = "genera-una-clave-aleatoria-larga-aqui"

# ── Azure AD / Microsoft Graph (mismo tenant que el Informe de Cierre) ───
[azure]
tenant_id     = "..."
client_id     = "..."
client_secret = "..."
# site_name   = "Gestion"   # opcional, default "Gestion"

# ── Usuarios y contraseñas (misma tabla que usa el Informe de Cierre) ────
[usuarios]
[usuarios."elazo@aguasanta.cl"]
password = "cambia_esto"
grupos = []

[usuarios."flow@aguasanta.cl"]
password = "cambia_esto"
grupos = []

# ── Credenciales SQL Server (Presupuesto/ProduccionFundos/ManoDeObra) ────
[sql_gastos]
server   = "192.9.200.4,1433"
database = "Presupuesto"
user     = "..."
password = "..."
